<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>co.edu.unicauca.saga</groupId>
    <artifactId>agencia-viajes-saga</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Agencia de viajes - patron SAGA con Temporal</name>

    <modules>
        <module>servicio-vuelos</module>
        <module>servicio-hoteles</module>
        <module>servicio-autos</module>
        <module>servicio-pagos</module>
        <module>servicio-notificaciones</module>
        <module>orquestador</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <temporal.version>1.40.0</temporal.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- Dependencias comunes a los cinco microservicios simulados -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.temporal</groupId>
                <artifactId>temporal-sdk</artifactId>
                <version>${temporal.version}</version>
            </dependency>
            <dependency>
                <groupId>io.temporal</groupId>
                <artifactId>temporal-testing</artifactId>
                <version>${temporal.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
